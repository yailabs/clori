flowchart TB
    subgraph prefill[A. Prompt prefill]
        direction LR
        prompt[Prompt text / messages]
        tokenizer[Exact tokenizer]
        ids[Prompt token IDs]
        transformer[Chunked Transformer prefill<br/>+ prompt KV commit]
        hidden[Normalized hidden]
        logits[Complete vocabulary logits]
        sample[Sampling]
        first[First selected token]
        prompt --> tokenizer --> ids --> transformer --> hidden --> logits --> sample --> first
    end

    subgraph loop[B. Generated-token loop]
        direction LR
        current[Current normalized hidden]
        next_logits[Complete logits]
        next_sample[Sample token]
        classify{EOS / stop?}
        terminal[Terminal record<br/>no KV advance]
        decode[Decode exact sampled ID]
        commit[Model + KV commit]
        detokenize[Incremental detokenizer]
        publish[Committed UTF-8 fragment]
        current --> next_logits --> next_sample --> classify
        classify -->|yes| terminal
        classify -->|ordinary| decode --> commit --> detokenize --> publish
        commit --> current
    end

    first --> classify

    subgraph transaction[C. Per-token transaction]
        direction LR
        staged[Sampled token staged]
        candidate[Decode candidate]
        validate[Validate]
        model_commit[Model commit]
        text_commit[Decoder / text commit]
        staged --> candidate --> validate --> model_commit --> text_commit
    end
