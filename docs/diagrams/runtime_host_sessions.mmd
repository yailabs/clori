flowchart LR
    subgraph clients[Client connections]
        client_a[Client A]
        client_b[Client B]
        native_n[Native client N]
        apps[SDKs / applications]
    end

    subgraph host[yvex serve — persistent multi-engine host]
        protocol[Private local protocol]
        openai[In-process OpenAI adapter]
        resources[Engine manager<br/>package + specialization + resources]
        queue[Bounded request queue]
        worker[Per-engine scheduler workers]
        registry[Session registry]

        subgraph session[Generation-bound conversation session]
            transcript[Transcript + token ledger]
            execution[Persistent execution session<br/>KV + position]
            turn[Turn state + RNG + decoder]
        end

        protocol --> queue --> worker
        openai <--> protocol
        resources --> worker
        registry --> session
        worker <--> turn
        transcript <--> turn
        execution <--> turn
    end

    subgraph telemetry[Typed event authority]
        events[Ordered runtime events]
        metrics[Metrics accumulator]
        events --> metrics
    end

    subgraph surfaces[Client-facing surfaces]
        raw[Raw trace]
        watch[Engine watch]
        chat[REPL / chat]
    end

    clients <--> protocol
    apps <--> openai
    worker --> events
    turn --> events
    events --> raw
    events --> watch
    protocol <--> chat
