flowchart LR
    subgraph compile[A. Compile]
        source[Verified sources]
        compiler[YVEX compiler]
        artifact[Immutable package<br/>+ runtime binding]
        source --> compiler --> artifact
    end

    subgraph host[B. Run — persistent yvex serve]
        protocol[Private local protocol]
        openai[Loopback OpenAI adapter]
        sessions[Engine manager<br/>+ generation-bound sessions]
        worker[Per-engine scheduler<br/>+ executable batches]
        events[Typed runtime events]
        protocol <--> sessions
        openai <--> protocol
        sessions <--> worker
        worker --> events
    end

    subgraph execution[C. Execute]
        graph[Runtime graph]
        backend[CPU / CUDA]
        state[Transactional state]
        graph --> backend --> state
    end

    subgraph interact[D. Interact]
        raw[Raw trace]
        watch[Engine watch]
        chat[yvex chat]
        admin[yvex host / engine / session]
        apps[SDKs / applications]
    end

    artifact -->|load + specialize| sessions
    worker <--> graph
    events --> raw
    events --> watch
    protocol <--> chat
    protocol <--> admin
    openai <--> apps

    offline[yvex<br/>offline engineering lane]
    offline -.-> compiler
    offline -.-> artifact
